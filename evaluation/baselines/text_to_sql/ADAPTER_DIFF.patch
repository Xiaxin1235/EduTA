+"""Two unaggregated TEMP views over the exact frozen research inputs."""
+import sqlite3
+import time
+from paths import CANDIDATE, read_json
+
+# research_data.attach: ID AND year joins, CASE (not COALESCE), no row exclusions.
+SCHOOLS_SQL = '''CREATE TEMP VIEW schools AS SELECT
+ b.id,b.year,
+ CASE WHEN m.source_school_year_id IS NOT NULL THEN m.normalized_province ELSE b.normalized_province END AS province,
+ CASE WHEN f.source_school_year_id IS NOT NULL THEN f.new_value WHEN m.source_school_year_id IS NOT NULL THEN m.normalized_city ELSE b.normalized_city END AS city,
+ CASE WHEN m.source_school_year_id IS NOT NULL THEN m.normalized_district ELSE b.normalized_district END AS district,
+ b.school_name,b.school_type,b.school_area_type,b.class_num,b.teacher_num,b.student_num,b.data_mark,b.region,
+ b.province AS raw_province,b.city AS raw_city,b.district AS raw_district,
+ CASE WHEN m.source_school_year_id IS NOT NULL THEN m.normalized_province ELSE b.normalized_province END AS query_province,
+ CASE WHEN f.source_school_year_id IS NOT NULL THEN f.new_value WHEN m.source_school_year_id IS NOT NULL THEN m.normalized_city ELSE b.normalized_city END AS query_city,
+ CASE WHEN m.source_school_year_id IS NOT NULL THEN m.normalized_district ELSE b.normalized_district END AS query_district,
+ r.status AS research_status,
+ CASE WHEN m.source_school_year_id IS NOT NULL THEN 'V4_EVIDENCE_OVERLAY' ELSE 'V1_FORMAT_BASE' END AS metadata_source,
+ f.rule_id AS additional_format_rule
+ FROM research_base.school_records b
+ LEFT JOIN research_mapping.record_metadata m ON m.source_school_year_id=b.id AND m.year=b.year
+ LEFT JOIN research_mapping.format_extension_v5 f ON f.source_school_year_id=b.id AND f.year=b.year
+ LEFT JOIN research_mapping.research_review_v5 r ON r.source_school_year_id=b.id AND r.year=b.year'''
+
+# Flatten the public question dictionary into each answer, without aggregation.
+ANSWERS_SQL = '''CREATE TEMP VIEW answers AS SELECT
+ a.school_id,a.question_id,a.value,a.normalized_value,
+ q.level1_name AS dimension,q.content AS question_content
+ FROM raw_source.answers a LEFT JOIN raw_source.questions q ON q.id=a.question_id'''
+
+SCHOOL_COLUMNS = [
+ ('id','INTEGER','学校年度记录主键，不是跨年学校身份'),('year','TEXT','记录年度'),
+ ('province','TEXT','规范省级字段'),('city','TEXT','规范城市全称'),('district','TEXT','规范区县'),
+ ('school_name','TEXT','源记录学校名'),('school_type','TEXT','学段原字段'),
+ ('school_area_type','TEXT','城乡原字段'),('class_num','TEXT','班级数原字段'),
+ ('teacher_num','TEXT','教师数原字段'),('student_num','TEXT','学生数原字段'),
+ ('data_mark','INTEGER','源记录标记'),('region','TEXT','源记录区域'),
+ ('raw_province','TEXT','原始省份'),('raw_city','TEXT','原始城市'),('raw_district','TEXT','原始区县'),
+ ('query_province','TEXT','等于 province'),('query_city','TEXT','等于 city'),
+ ('query_district','TEXT','等于 district'),('research_status','TEXT','v5 研究状态，非排除条件'),
+ ('metadata_source','TEXT','元数据来源'),('additional_format_rule','TEXT','v5 城市格式规则')]
+ANSWER_COLUMNS = [('school_id','INTEGER','关联 schools.id'),('question_id','INTEGER','83 题的题号'),
+ ('value','REAL','原始数值，0 有效，NULL 缺失'),
+ ('normalized_value','REAL','已有归一化数值；分数乘 100'),
+ ('dimension','TEXT','题目所属一级维度'),('question_content','TEXT','原题目文本')]
+TABLES = {'schools': SCHOOL_COLUMNS, 'answers': ANSWER_COLUMNS}
+
+
+def connect():
+    cfg = read_json(CANDIDATE / 'config/research_dataset.json')
+    conn = sqlite3.connect(':memory:', uri=True)
+    for alias, key in [('raw_source','source'),('research_base','base_v1'),('research_mapping','mapping_v5')]:
+        from pathlib import Path
+        conn.execute('ATTACH DATABASE ? AS ' + alias,
+                     (Path(cfg['data'][key]['path']).as_uri() + '?mode=ro',))
+    conn.execute(SCHOOLS_SQL)
+    conn.execute(ANSWERS_SQL)
+    conn.execute('PRAGMA query_only=ON')
+    return conn
+
+
+def public_read_only(action, table, column, database, origin):
+    if action in (sqlite3.SQLITE_SELECT, sqlite3.SQLITE_FUNCTION, sqlite3.SQLITE_RECURSIVE):
+        return sqlite3.SQLITE_OK
+    if action == sqlite3.SQLITE_READ:
+        if database == 'temp' and table in TABLES:
+            return sqlite3.SQLITE_OK
+        if origin == 'schools' and database in ('research_base','research_mapping'):
+            return sqlite3.SQLITE_OK
+        if origin == 'answers' and database == 'raw_source' and table in ('answers','questions'):
+            return sqlite3.SQLITE_OK
+        # SQLite's view flattener attributes an unused LEFT JOIN row-presence
+        # read to the enclosing CTE (empty column), rather than to answers.
+        if database == 'raw_source' and table == 'questions' and column == '':
+            return sqlite3.SQLITE_OK
+    return sqlite3.SQLITE_DENY
+
+
+def execute_sql(sql, parameters=(), seconds=120):
+    """Fetch one sentinel row beyond 50, and retain at most 50 result rows."""
+    conn = connect()
+    denied = []
+    def authorize(*args):
+        decision = public_read_only(*args)
+        if decision == sqlite3.SQLITE_DENY:
+            denied.append(list(args))
+        return decision
+    conn.set_authorizer(authorize)
+    started = time.monotonic()
+    deadline = started + seconds
+    conn.set_progress_handler(lambda: int(time.monotonic() >= deadline), 1000)
+    out = {'sql': sql, 'columns': [], 'rows': [], 'over_50_rows': False,
+           'error': None, 'timed_out': False}
+    try:
+        cursor = conn.execute(sql, parameters)
+        if cursor.description is None:
+            raise sqlite3.OperationalError('SQL did not return a result set')
+        rows = cursor.fetchmany(51)
+        out.update(columns=[d[0] for d in cursor.description], rows=[list(r) for r in rows[:50]],
+                   over_50_rows=len(rows) > 50)
+    except sqlite3.Error as exc:
+        out.update(error=str(exc), timed_out=time.monotonic() >= deadline)
+        if denied:
+            out['denied_access'] = denied
+    finally:
+        out['elapsed_s'] = time.monotonic() - started
+        conn.close()
+    return out
